{
  "version": "3.1",
  "data_api_version": "3.0",
  "routing_model": {
    "HOME": [
      "APPOINTMENT_FORM"
    ]
  },
  "screens": [
    {
      "id": "HOME",
      "title": "Hospital Booking",
      "data": {},
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Welcome to TN Health Connect"
          },
          {
            "type": "TextBody",
            "text": "Please book your appointment below."
          },
          {
            "type": "Footer",
            "label": "Book Appointment",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "APPOINTMENT_FORM"
              }
            }
          }
        ]
      }
    },
    {
      "id": "APPOINTMENT_FORM",
      "title": "Book Appointment",
      "data": {},
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextInput",
            "label": "Patient Name",
            "name": "patient_name",
            "required": true
          },
          {
            "type": "TextInput",
            "label": "Patient Age",
            "name": "patient_age",
            "input-type": "number",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Confirm Booking",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "patient_name": "${form.patient_name}",
                "patient_age": "${form.patient_age}"
              }
            }
          }
        ]
      }
    }
  ]
}